# ============================================================
# Interactive Blob Poster  (Google Colab)  — truly interactive
# Paste into ONE Colab cell and run it.
# The poster runs as live JavaScript inside the cell output:
#   • hover  -> nearby shapes swell
#   • click  -> adds a new shape where you click
#   • shift+click a shape -> removes it
#   • dropdown/sliders -> palette, jaggedness, opacity, outline
#   • buttons -> reshuffle, save PNG
# ============================================================
import json
from IPython.display import HTML, display

# Color suggestions (bg, shape fills, outline). Add your own!
PALETTES = {
    "Mono blue":     {"bg": "#FFFFFF", "fills": ["#DCE6F7", "#A9B8D6", "#8FA0BE", "#7F91B3", "#B7BFD3"], "line": "#2B3447", "text": "#000000"},
    "Blue + coral":  {"bg": "#F7F4EF", "fills": ["#CFE0F5", "#8FB3E0", "#5C86C5", "#F2A38F", "#E4725C"], "line": "#2B3447", "text": "#1B2333"},
    "Teal + sand":   {"bg": "#F3EEE3", "fills": ["#BFE0DA", "#7FC1B8", "#3E9A93", "#E8C98B", "#D9A15B"], "line": "#1F3B3A", "text": "#1F3B3A"},
    "Dusk":          {"bg": "#1B1530", "fills": ["#5B4B9A", "#9A5FB0", "#E0678F", "#F29E6B", "#F6D58E"], "line": "#0F0B1D", "text": "#FFFFFF"},
}

PAGE = r"""
<div id="wrap" style="font-family:system-ui,sans-serif;max-width:480px">
  <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px;font-size:13px">
    <select id="pal"></select>
    <label>Jagged <input id="jag" type="range" min="0" max="0.2" step="0.005" value="0.05"></label>
    <label>Opacity <input id="alp" type="range" min="0.2" max="1" step="0.05" value="0.75"></label>
    <label>Outline <input id="lw" type="range" min="0" max="6" step="0.5" value="2.5"></label>
    <button id="shuf">Shuffle</button><button id="clr">Reset</button><button id="png">Save PNG</button>
  </div>
  <svg id="s" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400"
       style="width:100%;border-radius:8px;box-shadow:0 2px 12px #0004;touch-action:none;cursor:crosshair"></svg>
</div>
<script>
(function(){
const P = __PALETTES__, N = 70, NS = "http://www.w3.org/2000/svg";
const svg = document.getElementById("s"), $ = id => document.getElementById(id);
Object.keys(P).forEach(k => $("pal").add(new Option(k, k)));
let items = [], mouse = null, seed = 7;
function R(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
let rnd = R(seed);
function blob(x, y, r){
  return {x, y, r, e:.7+rnd()*.5, a:rnd()*3.14, c:Math.floor(rnd()*100),
          j:Array.from({length:N}, () => rnd()-.5), s:1, t:1, g:null, p:null};
}
function path(b){
  const jag = +$("jag").value; let d = "";
  for(let i=0;i<N;i++){
    const t=i/N*6.283, r=b.r*(1-jag*(i%2))*(1+b.j[i]*jag*.3);
    const x=Math.cos(t)*r*b.e, y=Math.sin(t)*r, c=Math.cos(b.a), s=Math.sin(b.a);
    d += (i?"L":"M")+(x*c-y*s).toFixed(1)+" "+(x*s+y*c).toFixed(1);
  }
  return d+"Z";
}
function make(){ rnd = R(seed); items = []; for(let i=0;i<13;i++) items.push(blob(30+rnd()*240, 50+rnd()*300, (.4+rnd()*.6)*75)); build(); }
function el(n, a, p){ const e=document.createElementNS(NS,n); for(const k in a) e.setAttribute(k,a[k]); p&&p.appendChild(e); return e; }
function build(){
  svg.innerHTML = ""; const p = P[$("pal").value];
  el("rect", {width:300, height:400, fill:p.bg}, svg);
  items.forEach(b => {
    b.g = el("g", {}, svg);
    b.p = el("path", {"stroke-linejoin":"round"}, b.g);
    b.g.addEventListener("pointerdown", e => { if(e.shiftKey){ e.stopPropagation(); items = items.filter(i=>i!==b); build(); }});
  });
  const t = el("text", {x:8, y:20, "font-size":15, "font-weight":700, "font-family":"sans-serif", fill:p.text}, svg);
  t.textContent = "Interactive Poster • " + $("pal").value.toLowerCase();
  t.style.pointerEvents = "none"; restyle();
}
function restyle(){
  const p = P[$("pal").value];
  items.forEach(b => {
    b.p.setAttribute("d", path(b));
    b.p.setAttribute("fill", p.fills[b.c % p.fills.length]);
    b.p.setAttribute("fill-opacity", $("alp").value);
    b.p.setAttribute("stroke", p.line);
    b.p.setAttribute("stroke-width", $("lw").value);
  });
}
function pt(e){ const r=svg.getBoundingClientRect(); return [(e.clientX-r.left)/r.width*300, (e.clientY-r.top)/r.height*400]; }
svg.addEventListener("pointermove", e => mouse = pt(e));
svg.addEventListener("pointerleave", () => mouse = null);
svg.addEventListener("pointerdown", e => {
  if(e.shiftKey) return; const [x,y] = pt(e);
  const b = blob(x, y, 20+rnd()*45); items.push(b); build();
});
(function loop(){
  items.forEach(b => {
    const d = mouse ? Math.hypot(b.x-mouse[0], b.y-mouse[1]) : 1e9;
    b.t = 1 + Math.max(0, 1-d/90)*.35;
    b.s += (b.t-b.s)*.15;
    b.g && b.g.setAttribute("transform", `translate(${b.x} ${b.y}) scale(${b.s})`);
  });
  requestAnimationFrame(loop);
})();
["pal","jag","alp","lw"].forEach(id => $(id).addEventListener("input", () => id==="pal" ? build() : restyle()));
$("shuf").onclick = () => { seed = Math.floor(Math.random()*1e6); make(); };
$("clr").onclick  = () => { seed = 7; make(); };
$("png").onclick  = () => {
  const xml = new XMLSerializer().serializeToString(svg), img = new Image();
  img.onload = () => {
    const c = document.createElement("canvas"); c.width = 1800; c.height = 2400;
    c.getContext("2d").drawImage(img, 0, 0, 1800, 2400);
    c.toBlob(b => { const a = document.createElement("a"); a.href = URL.createObjectURL(b); a.download = "poster.png"; a.click(); });
  };
  img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(xml);
};
make();
})();
</script>
"""

display(HTML(PAGE.replace("__PALETTES__", json.dumps(PALETTES))))
